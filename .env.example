# Copy to .env for local development. Placeholders only; never commit real values.

# --- Chat providers (configure at least one) ---
NEXORA_PROVIDER=gemini            # gemini | anthropic | openai | ollama
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
GEMINI_FALLBACK_MODELS=gemini-3.7-flash,gemini-3.1-flash-lite   # tried on quota/overload; empty = none
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OLLAMA_BASE_URL=                  # e.g. http://localhost:11434 (local only)
OLLAMA_MODEL=llama3.1

# --- Limits ---
LLM_TIMEOUT_SECONDS=60
MAX_OUTPUT_TOKENS=2048
RATE_LIMIT_PER_MINUTE=10
MAX_MESSAGE_CHARS=8000
HISTORY_TURNS=10

# --- Sign-in (required for documents and /build) ---
NEXORA_USERS=                     # alice:<hash>,bob:<hash>   (python -m nexora.auth)
CHAINLIT_AUTH_SECRET=             # chainlit create-secret

# --- Documents / RAG (Postgres + pgvector) ---
DATABASE_URL=                     # postgresql://user:password@host/db?sslmode=require
EMBEDDING_PROVIDER=gemini         # gemini | openai
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIM=768
RAG_TOP_K=5
RAG_MIN_SCORE=0.55
MAX_UPLOAD_MB=10

# --- MetaGPT worker (used by the web app) ---
METAGPT_WORKER_URL=               # e.g. http://127.0.0.1:8001
METAGPT_WORKER_TOKEN=             # same value as the worker's token

# --- MetaGPT worker service (set on the worker only) ---
# METAGPT_WORKER_TOKEN=           # random, 32+ characters
# METAGPT_API_TYPE=gemini
# METAGPT_MODEL=gemini-3.5-flash
# METAGPT_API_KEY=
# METAGPT_JOB_TIMEOUT_SECONDS=900
# METAGPT_MAX_TOKENS=16384
# WORKER_JOBS_DIR=worker-jobs
